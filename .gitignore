*.jks
*.idsig

# android.jar: 27 MB, fetched per README
sdk/
*.jar

# bundled runtimes: ~236 MB (arm64) and ~240 MB (x64) each exceed GitHub's
# 100 MB per-file limit. Recreate with stage-assets-v2.ps1 / stage-assets-x64.ps1.
# The x64 shim binary lives here too; it is produced from shim\shim.c by
# shim\build.ps1 (ocstandalone\build.ps1 calls it when the file is absent).
ocstandalone/assets/arm64/
ocstandalone/assets/x64/

